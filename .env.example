# Environment Variables for Gamified Environmental Education Platform
# Copy this file to .env and update the values

# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production-make-it-very-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (for production)
DB_NAME=ecolearn_db
DB_USER=ecolearn_user  
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration — REQUIRED for real password-reset emails on your phone
# For Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=jeevan30gowda@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EcoLearn Platform <jeevan30gowda@gmail.com>

# Site URL (must match how you access the app in browser)
SITE_DOMAIN=127.0.0.1:8000
SITE_PROTOCOL=http

# Social Login (Google & Facebook OAuth)
# Google: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Authorized redirect URI: http://127.0.0.1:8000/accounts/auth/google/login/callback/
# 3. Paste Client ID and Secret below, then run: python manage.py setup_social_auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps/
# Redirect URI: http://127.0.0.1:8000/accounts/auth/facebook/login/callback/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
